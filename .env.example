# ===================================================
# GoEasy Travels Environment Configuration Template
# ===================================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Database URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/goeasy_booking?retryWrites=true&w=majority

# JSON Web Token Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Redis Cloud Cache URI (Optional - fallback to memory cache if omitted)
REDIS_URI=redis://default:<password>@<host>:<port>

# Cloudinary Storage URI (Optional - fallback to local disk storage if omitted)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Nodemailer SMTP Email Alerts
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="GoEasy Travels Notifications <no-reply@goeasy.com>"
